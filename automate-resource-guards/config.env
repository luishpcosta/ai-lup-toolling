# Configuração dos guards de recurso/orçamento PreToolUse (hooks/guards/).
# Editável diretamente — carregado em tempo de execução por hooks/lib.sh
# sempre que qualquer guard desta pasta roda.
#
# Se uma variável já estiver exportada no ambiente de quem chamou o script,
# ela vence sobre o valor definido aqui.

# Liga/desliga o guard. LIGADO por padrão — mesma justificativa de
# automate-security/: checagem rápida, sem efeito colateral perigoso.
RESOURCE_GUARD_ENABLED=true

# Máximo de subagentes ativos simultâneos antes de bloquear novos spawns.
RESOURCE_GUARD_MAX_SUBAGENTS=5

# Segundos até um subagente spawnado ser considerado "não mais ativo" pra
# fins de contagem (o guard não sabe quando um subagente termina de
# verdade, só estima por idade — mesma limitação do script original).
RESOURCE_GUARD_TTL_SECONDS=1800

# Caminho do arquivo de tracking (compartilhado por máquina). Descomente
# pra mudar do default (~/.claude/active-agents):
# RESOURCE_GUARD_TRACKER_PATH=/root/.claude/active-agents

# Onde grava o trace log (spawns BLOCKED). Vazio = data/trace.log nesta
# pasta. Descomente pra gravar em outro lugar:
# RESOURCE_GUARD_TRACE_LOG_PATH=/root/development/tools/automate-resource-guards/data/trace.log
