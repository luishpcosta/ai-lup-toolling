# Configuração da automação de review de PR pós-push (hooks/).
# Editável diretamente — carregado em tempo de execução por hooks/lib.sh
# sempre que qualquer script desta pasta roda. Substitui a necessidade de
# exportar variáveis de ambiente manualmente no shell.
#
# Se uma variável já estiver exportada no ambiente de quem chamou o script,
# ela vence sobre o valor definido aqui (útil para overrides pontuais de
# teste sem editar este arquivo).

# Liga/desliga a automação. Desligada por padrão — mude para "true" para
# habilitar nesta máquina.
AGENT_PR_REVIEW_ENABLED=false

# Intervalo (segundos) entre tentativas de polling da CI.
AGENT_PR_REVIEW_POLL_INTERVAL_SEC=30

# Número máximo de tentativas antes de declarar estado indeterminado (timeout).
AGENT_PR_REVIEW_POLL_MAX_ATTEMPTS=20

# Máximo de revisões automatizadas (invocações reais da plataforma agêntica)
# permitidas por (repositório, branch). Persistido em data/reviews.db (SQLite,
# via hooks/review-db.py) — a contagem nunca reseta sozinha, só manualmente
# (ver README.md > "Gate de revisões por branch"). Acima do limite, a
# automação só loga que não foi iniciada; não abre janela nem consome mais
# nenhum recurso.
AGENT_PR_REVIEW_MAX_PER_BRANCH=3

# Lista opt-in de repositórios ("owner/repo") em que, no sucesso da CI, a
# automação NÃO abre a revisão — em vez disso comenta na PR e faz merge
# imediato (`gh pr merge --merge`, merge commit, SEM esperar requisitos
# extras de branch protection — ver README.md > "Merge automático por
# repositório" para o aviso de risco). Vazia por padrão: nenhum repositório
# tem merge automático até ser explicitamente listado aqui. Repositórios
# nesta lista são INDEPENDENTES do limite acima (nunca contam nem checam o
# gate).
AGENT_PR_REVIEW_AUTOMERGE_REPOS=()
# AGENT_PR_REVIEW_AUTOMERGE_REPOS=(minha-org/repo-interno)

# Pasta onde a janela final sempre abre (contém .claude/skills/review-pr/).
AGENT_PR_REVIEW_SKILL_PATH=/root/development/tools/automate-review

# Programa + flags usados para abrir a janela final, como um ARRAY bash (não
# string) — cada elemento vira um argv separado, então caminhos com espaço
# funcionam sem escaping manual.
#
# IMPORTANTE: no momento, o programa configurado aqui PRECISA ser compatível
# com bash — o script que ele executa é sempre gerado em bash (cd/cat/echo +
# a invocação da plataforma), então PowerShell ou cmd.exe puro não funcionam
# (ver README.md > "Trocar o terminal" para o porquê e as alternativas).
#
# Default: Git Bash nativo do Windows. Para usar outro shell compatível com
# bash, descomente e ajuste a linha abaixo — por sua conta e risco:
AGENT_PR_REVIEW_TERMINAL_CMD=('C:\Program Files\Git\usr\bin\bash.exe' -i -l)
# AGENT_PR_REVIEW_TERMINAL_CMD=('C:\Program Files\Git\bin\bash.exe' -i -l)   # o "outro" bash.exe do Git for Windows (o shim, não o MSYS real)
# AGENT_PR_REVIEW_TERMINAL_CMD=(wsl.exe bash)                                 # WSL2 — não testado, pode não funcionar dependendo do host

# Programa + prompt usados para invocar a plataforma agêntica no estado
# SUCCESS, como um ARRAY bash — mesma lógica do TERMINAL_CMD acima. Cada
# elemento pode conter os placeholders literais "{pr_url}" (substituído pela
# URL real da PR) e "{repo}" (substituído por "owner/repo"). Sempre prefixado
# com MSYS_NO_PATHCONV=1 automaticamente (não precisa incluir aqui) e cada
# elemento é escapado com segurança na hora de montar o comando final —
# prompts com espaço/aspas funcionam sem escaping manual.
#
# Roda DIRETO no processo do poller (sem abrir janela — ver README.md >
# "Como funciona"), com cwd no repositório que fez o push. Só abre uma janela
# se este comando falhar (exit != 0), pra chamar atenção.
#
# INVARIANTE: nunca acrescente "--continue"/"--resume" — cada push precisa
# disparar uma sessão nova e stateless, sem herdar contexto de pushes
# anteriores na mesma branch. O default usa "claude -p" (não-interativo) com
# uma allowlist de ferramentas (--allowedTools) em vez de bypass total de
# permissão: só os comandos "gh"/"git"/leitura abaixo rodam sem prompt;
# qualquer coisa fora da lista é NEGADA automaticamente (não trava — não há
# terminal pra responder um prompt de permissão). Ajuste a lista conforme o
# que a skill/comando de revisão do seu repositório realmente precisa rodar
# (ex.: um script de lint) — nunca amplie pra algo genérico tipo "Bash(*)".
#
# Default: Claude Code, sem skill fixa — pede pra popular a descrição da PR
# (a partir de git log/diff) e revisar o código, usando /review-pr se este
# projeto tiver essa skill instalada localmente (cada repositório escolhe a
# sua — a automação não instala nem exige nenhuma). Ver README.md >
# "Plataforma agêntica" para o texto completo do prompt e para o exemplo do
# Devin CLI:
AGENT_PR_REVIEW_PLATFORM_CMD=(
  claude -p
  'Contexto: execução automática, não-interativa, disparada porque a CI passou na PR {pr_url} do repositório {repo}. Não há usuário observando esta sessão — não peça confirmação nem espere aprovação, publique diretamente. Primeiro, veja a descrição atual da PR (gh pr view {pr_url} --json body) e, se estiver vazia ou não refletir o que foi feito, gere uma nova a partir de git log/git diff da branch atual e grave com gh pr edit {pr_url} --body-file -. Depois, revise o código desta PR (use a skill /review-pr se este projeto tiver uma instalada; senão, revise você mesmo o diff) e publique os comentários/relatório diretamente, sem esperar aprovação.'
  --permission-mode dontAsk
  --allowedTools
  'Bash(gh pr view *)'
  'Bash(gh pr diff *)'
  'Bash(gh pr edit *)'
  'Bash(gh pr comment *)'
  'Bash(gh pr review *)'
  'Bash(git log *)'
  'Bash(git diff *)'
  'Bash(git show *)'
  'Bash(git status *)'
  Read
  Glob
  Grep
)
# Devin CLI — "devin -p" confirmado em docs.devin.ai/cli/essential-commands
# (modo single-turn, imprime a resposta e sai; sem -c/-r continua stateless,
# igual "claude -p" sem --continue/--resume). NÃO tem allowlist granular
# documentada (nada equivalente a --allowedTools) — a única forma confirmada
# de rodar gh/git sem prompt de aprovação é "--permission-mode bypass", que
# libera QUALQUER comando (mais arriscado que o default acima). Também não
# há subcomando/skill de review documentado, então o prompt pede pro próprio
# Devin revisar o diff, sem depender de "/review-pr":
# AGENT_PR_REVIEW_PLATFORM_CMD=(
#   devin -p
#   'Contexto: execução automática, não-interativa, disparada porque a CI passou na PR {pr_url} do repositório {repo}. Não há usuário observando esta sessão — não peça confirmação nem espere aprovação, publique diretamente. Primeiro, veja a descrição atual da PR (gh pr view {pr_url} --json body) e, se estiver vazia ou não refletir o que foi feito, gere uma nova a partir de git log/git diff da branch atual e grave com gh pr edit {pr_url} --body-file -. Depois, revise o código desta PR a partir do diff (gh pr diff {pr_url}) e publique os comentários/relatório via gh pr review/gh pr comment diretamente, sem esperar aprovação.'
#   --permission-mode bypass
# )

# Caminho do trace log central (nível de máquina — push detectado, revisão
# invocada/bloqueada pelo gate, merge automático etc.). Vazio por padrão =
# data/trace.log dentro desta pasta. Descomente pra gravar em outro lugar:
# AGENT_PR_REVIEW_TRACE_LOG_PATH=/root/development/tools/automate-review/data/trace.log
