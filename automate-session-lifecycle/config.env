# Configuração dos hooks de ciclo de vida de sessão (hooks/scripts/).
# Editável diretamente — carregado em tempo de execução por hooks/lib.sh.
#
# Se uma variável já estiver exportada no ambiente de quem chamou o script,
# ela vence sobre o valor definido aqui.

# Liga/desliga o checkpoint automático de pré/pós-compactação.
SESSION_LIFECYCLE_CHECKPOINT_ENABLED=true

# Liga/desliga a espera de warmup do MCP no início da sessão.
SESSION_LIFECYCLE_WARMUP_ENABLED=true

# Segundos de espera no warmup, quando mcpServers está configurado.
SESSION_LIFECYCLE_WARMUP_SECONDS=3

# Onde grava o trace log (commit criado, warmup esperado). Vazio =
# data/trace.log nesta pasta. Descomente pra gravar em outro lugar:
# SESSION_LIFECYCLE_TRACE_LOG_PATH=/root/development/tools/automate-session-lifecycle/data/trace.log
